# Supabase project URL — public, ใช้ฝั่ง client ได้ (src/lib/supabase/client.ts, server.ts)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key — public, RLS ยังบังคับอยู่ (src/lib/supabase/client.ts, server.ts)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypass RLS ทั้งหมด ห้าม import จากไฟล์ "use client"
# (ใช้ใน src/lib/supabase/admin.ts เช่นอ่าน questions.correct_index ที่ไม่มี select policy)
SUPABASE_SERVICE_ROLE_KEY=

# รายชื่ออีเมลแอดมิน คั่นด้วย comma ใช้เช็ค allowlist เข้าหน้า /admin/* (ยังไม่มีระบบ role ใน profiles)
ADMIN_EMAILS=

# allowlist แยกต่างหากสำหรับหน้า /admin/analytics/thepmitr เท่านั้น (คั่นด้วย comma) — แยกจาก
# ADMIN_EMAILS เพราะหน้านี้ล็อกข้อมูลเฉพาะโรงเรียนเทพมิตรศึกษาให้คนที่เกี่ยวข้องดูได้
# ไม่ใช่แอดมินระบบทั่วไป (หน้า /admin/analytics เดิมยังใช้ ADMIN_EMAILS เหมือนเดิม เห็นได้ทุกโรงเรียน)
ANALYTICS_ADMIN_EMAILS=

# Gemini API key (free tier) — server-only ห้ามมี prefix NEXT_PUBLIC_ (ใช้ใน src/lib/qmon/askQmon.ts
# เรียก Gemini ผ่าน fetch ตรงๆ สำหรับเมนู "ขอแรงใจ")
GEMINI_API_KEY=
